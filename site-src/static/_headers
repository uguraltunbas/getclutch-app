# Cloudflare Workers Static Assets — response headers for clutchledger.com.
# HTML is short-lived (rebuilt four times a day; live scores come from the
# browser); everything under /assets/ is content-hashed, so it is immutable.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' __SUPABASE_URL__ https://cloudflareinsights.com; manifest-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=120, stale-while-revalidate=600

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/og/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/email/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

# The embeddable boxes (/embed/…, lib/pages/embed.mjs) sit in other sites' frames: framable by
# anyone, and nothing but their stylesheet loads in them.
/embed/*
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors *
